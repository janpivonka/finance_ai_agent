generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  email         String?           @unique
  name          String?
  password      String?
  emailVerified DateTime?
  phone         String?
  bio           String?
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  isGuest       Boolean           @default(false)
  resetToken         String?   @unique
  resetTokenExpires  DateTime?
  accounts      Account[]
  analyses      AnalysisHistory[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalysisHistory {
  id                   String   @id @default(cuid())
  userId               String
  fixace               String
  aktualni_splatka     Float
  uspora               Float
  aktualni_trzni_sazba String
  pojisteni            String
  top_nabidky          String
  analyticky_duvod     String
  kreativni_vypocet    String
  uspora_slovy         String
  textovy_obsah        String
  timestamp            String
  date                 String
  fileName             String?
  clientPhone          String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

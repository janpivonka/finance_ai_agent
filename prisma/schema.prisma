// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String            @id @default(cuid())
  email             String?           @unique
  name              String?
  phone             String?
  bio               String?
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  accounts          Account[]
  analyses          AnalysisHistory[]
  isGuest           Boolean           @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // e.g. "github", "google", "facebook", "tiktok"
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AnalysisHistory {
  id                    String   @id @default(cuid())
  userId                String
  fixace                String
  aktualni_splatka      Float
  uspora                Float
  aktualni_trzni_sazba  String
  pojisteni             String
  top_nabidky           String   // JSON string
  analyticky_duvod      String
  kreativni_vypocet     String
  uspora_slovy          String
  textovy_obsah         String
  timestamp             String
  date                  String
  fileName              String?
  clientPhone           String?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
